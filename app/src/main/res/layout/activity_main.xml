<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Bandeau supérieur : titre + score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_titre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quiz des formes"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score : 0/5"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Texte de progression -->
    <TextView
        android:id="@+id/txt_progression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Progression : 0/5"
        android:textSize="16sp" />

    <!-- Barre de progression -->
    <ProgressBar
        android:id="@+id/progress_quiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="5"
        android:progress="0" />

    <!-- Zone défilante pour les petits écrans -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Numéro de la question -->
            <TextView
                android:id="@+id/txt_numero_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Question 1 sur 5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Image de la question -->
            <ImageView
                android:id="@+id/img_question"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Image de la question"
                android:scaleType="fitCenter" />

            <!-- Texte de la question -->
            <TextView
                android:id="@+id/txt_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Question"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Choix 1 -->
            <Button
                android:id="@+id/btn_choix2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Choix 2" />

            <Button
                android:id="@+id/btn_choix1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="Choix 1" />

            <!-- Choix 2 -->

            <!-- Choix 3 -->
            <Button
                android:id="@+id/btn_choix3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Choix 3" />

            <!-- Correction -->
            <TextView
                android:id="@+id/txt_correction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text=""
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Navigation -->
            <Button
                android:id="@+id/btn_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="Question suivante"
                android:visibility="gone" />

            <!-- Résultat final -->
            <LinearLayout
                android:id="@+id/layout_resultat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_resultat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Résultat final"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_message_final"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_rejouer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="Rejouer" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>